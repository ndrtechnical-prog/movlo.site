# GEMINI_API_KEY: Required for server-side Gemini AI article generation & SEO workflows.
# Set automatically in AI Studio Secrets or your server environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this applet is hosted (e.g., https://movlo.site).
APP_URL="https://movlo.site"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live YouTube trending discovery.
# Leave unset if not configured; trend discovery continues using Google Trends RSS, official News RSS, and Wikimedia APIs.
YOUTUBE_API_KEY=""
